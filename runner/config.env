# Marikai Configuration
# Copy this file to config.local.env and fill in your values.

# ─── Required ───────────────────────────────────────────────────────────────

# Marikai's location — used for weather
# Examples: "Athens, Greece" | "New York" | "Tokyo" | "Berlin"
LOCATION="Athens, Greece"

# ─── Optional ───────────────────────────────────────────────────────────────

# Claude model to use
MODEL="claude-opus-4-6"

# Maximum turns per session
MAX_TURNS="50"

# Whether to auto-commit to git after each session (true/false)
GIT_COMMIT="false"

# How many input items Marikai picks per session (articles, books, URLs, sayings, concepts)
INPUT_MIN="1"
INPUT_MAX="3"

# LangSearch API key — enables web search during sessions
# Free tier: 1,000 searches/day. Get a key at: https://langsearch.com/dashboard
LANGSEARCH_API_KEY=""

# ─── Semantic Memory ─────────────────────────────────────────────────────────

# Enable semantic memory search (true/false)
# When enabled, the 5 (SEMANTIC_TOP_K) most resonant passages from past writing are injected into
# each wake prompt under "Resonant Passages". Requires the venv below to be set up.
# Setup: python3 -m venv runner/venv && runner/venv/bin/pip install sentence-transformers faiss-cpu
SEMANTIC_ENABLED="true"

# How many resonant passages to surface per session.
# Each passage is a ~500-character chunk from journal, essay, creative, or letter files.
# The chunks most similar (by meaning, not keywords) to the last prompt are selected.
# 3 — tight, only the strongest connections. Less noise, shorter prompt.
# 5 — the default. Enough to surface a real pattern across different pieces of writing.
# 8+ — rich context, but makes the wake prompt noticeably longer, which uses more tokens
# on every session and may dilute focus.
# The tradeoff is signal vs. prompt length. 5 is a good default. If you notice the passages
# feel generic or repetitive, lower it to 3. If Marikai has a large corpus (100+ pieces) and 
# you want more serendipity, go to 7–8.
SEMANTIC_TOP_K="5"

# Path to the Python venv that has sentence-transformers and faiss-cpu installed.
# Leave empty to use the default: runner/venv/ (relative to runner/)
#
# If you already have the packages in another venv or conda env, point here instead:
#   SEMANTIC_VENV="/home/you/.virtualenvs/myenv"
#   SEMANTIC_VENV="/home/you/miniconda3/envs/myenv"
#
# The bin/python3 inside this path must be able to import sentence_transformers and faiss.
SEMANTIC_VENV=""

# ─── Publishing ──────────────────────────────────────────────────────────────

# Path to the publish repository (separate git repo, e.g. a GitHub Pages site)
# Leave empty to disable publishing
PUBLISH_DIR=""

# GitHub Pages base URL — the path after your domain.
# If your repo is github.com/you/marikai  → set to "/marikai"
# If your repo is github.com/you/you.github.io → set to ""
PUBLISH_BASEURL="/marikai"

# Space-separated list of paths inside marikai-brain/ to publish
# Outputs: journal creatives essays letters projects
# Inputs:  inputs/sayings.md inputs/concepts.md
# Identity: identity/about.md
PUBLISH_PATHS="journal creatives essays letters identity/about.md inputs/sayings.md inputs/concepts.md inputs/keeper-prompts.md data/session-log.md"

# Push to git remote after publishing (true/false)
PUBLISH_GIT_PUSH="false"
